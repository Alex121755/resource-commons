{
  "version": 1,
  "scope": "GitHub Pages connects to the hosted Resource Commons proxy for DeepSeek Flash. The optional Python service uses local Ollama or a configured OpenAI backend. Human review is required before saving AI suggestions. Group access is managed separately.",
  "health": {"method": "GET", "path": "/api/health", "response": {"service": "waicy-resource-commons", "backend": "local|openai|deepseek", "modelAvailable": "boolean", "model": "string", "localOnly": "boolean", "remoteProcessing": "boolean"}},
  "requestExtraction": {
    "method": "POST", "path": "/api/extract-request",
    "body": {"text": "string"},
    "response": {"model": "string", "backend": "local|openai|deepseek", "remoteProcessing": "boolean", "elapsedSeconds": "number", "data": {"purpose": "string", "needs": [{"id": "phone|display|chair|unsupported", "label": "string", "sourceText": "verbatim input excerpt", "quantity": "integer|null", "phoneWidthMm": "number|null", "phoneWeightG": "number|null"}], "startLocal": "YYYY-MM-DDTHH:mm|null", "endLocal": "YYYY-MM-DDTHH:mm|null", "allowAlternatives": "boolean|null", "missingQuestions": ["string"], "evidence": [{"field": "string", "quote": "string"}]}}
  },
  "itemExtraction": {
    "method": "POST", "path": "/api/extract-item",
    "body": {"image": "complete base64 data URL", "text": "optional string"},
    "response": {"model": "string", "backend": "local|openai|deepseek", "remoteProcessing": "boolean", "elapsedSeconds": "number", "data": {"name": "string|null", "category": "support|tripod|clamp|board|easel|chair|cable|unknown", "visibleQuantity": "integer|null", "visibleText": "string", "specSuggestions": [{"field": "string", "value": "string"}], "uncertainties": ["string"]}}
  },
  "sceneExtraction": {
    "method": "POST", "path": "/api/extract-scene",
    "body": {"image": "complete compressed JPEG data URL, client limit 1200000 characters"},
    "response": {"model": "string", "backend": "local|openai|deepseek", "remoteProcessing": "boolean", "elapsedSeconds": "number", "localOnly": "boolean", "requiresHumanConfirmation": "boolean", "data": {"items": [{"id": "string", "name": "string|null", "category": "electronics|tools|stationery|furniture|containers|other|unknown", "bbox": "[x1,y1,x2,y2] in 0..1000 normalized coordinates, or null", "visibleQuantity": "integer|null", "visibleText": "string", "uncertainties": ["string"]}], "sceneNotes": ["string"]}},
    "itemLimit": 12,
    "clientBehavior": "Cloud extraction requires per-request confirmation. Hosted requests include the X-Resource-Commons-Consent header set to cloud-v1 and the selected interface language. Save selected drafts manually after review. Invalid boxes retain the whole image. The draft store is separate from inventory and group membership."
  },
  "constraints": ["Missing facts must remain null", "Model output must never set approval or reservations", "Illustrated examples are synthetic. The origin of uploaded images remains unverified after recognition.", "No automatic save", "Unsupported requirement types must not silently count as fulfilled"]
